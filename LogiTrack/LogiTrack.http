@LogiTrack_HostAddress = https://localhost:7077

### 1) Register a new user (success)
POST {{LogiTrack_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "Password123!"
}

### 2) Register same user again (duplicate user)
POST {{LogiTrack_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "Password123!"
}

### 3) Register with weak password
POST {{LogiTrack_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "email": "weakuser@example.com",
  "password": "123"
}

### 4) Login with valid credentials
POST {{LogiTrack_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "Password123!"
}

### 5) Login with wrong password
POST {{LogiTrack_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "WrongPassword123!"
}

### 6) Login with non-existent user
POST {{LogiTrack_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "missing@example.com",
  "password": "Password123!"
}

### 7) Login with empty payload
POST {{LogiTrack_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "",
  "password": ""
}